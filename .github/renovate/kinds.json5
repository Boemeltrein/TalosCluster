{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  flux: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
    branchPrefix: "renovate/flux-",
    registryAliases: {
      "actions-runner-system": "oci://ghcr.io/actions/actions-runner-controller-charts",
      "bjw-s": "oci://ghcr.io/bjw-s-labs/helm",
      "cilium": "oci://quay.io/cilium/charts",
      "cloudnative-pg": "oci://ghcr.io/cloudnative-pg/charts",
      "grafana": "oci://ghcr.io/grafana/helm-charts",
      "grafana-community": "oci://ghcr.io/grafana-community/helm-charts",
      "home-operations": "oci://ghcr.io/home-operations/charts",
      "home-ops-mirror": "oci://ghcr.io/home-operations/charts-mirror",
      "jetstack": "oci://quay.io/jetstack/charts",
      "metallb": "oci://quay.io/metallb/chart",
      "node-feature-discovery": "oci://registry.k8s.io/nfd/charts",
      "openebs": "oci://ghcr.io/openebs/charts",
      "prometheus-community": "oci://ghcr.io/prometheus-community/charts",
      "renovate-operator": "oci://ghcr.io/mogenius/helm-charts",
      "spegel": "oci://ghcr.io/spegel-org/helm-charts",
      "truecharts": "oci://oci.trueforge.org/truecharts",
    },
  },
  kubernetes: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
    branchPrefix: "renovate/kubernetes-"
  },
  "github-actions": {
    branchPrefix: "renovate/githubactions-"
  },
  devcontainer: {
    branchPrefix: "renovate/devcontainer-"
  },
  packageRules: [
    {
      description: "Disable docker datasource for Kubernetes manager on HelmRelease files",
      matchManagers: ["kubernetes"],
      matchDatasources: ["docker"],
      matchFileNames: ["**/helm-release.yaml"],
      enabled: false
    }
  ]
}
